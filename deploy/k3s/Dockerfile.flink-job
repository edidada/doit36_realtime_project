ARG RUNTIME_JDK=17
ARG TEMURIN_IMAGE=docker.io/library/eclipse-temurin:${RUNTIME_JDK}-jre-jammy
ARG FLINK_IMAGE=docker.io/apache/flink:1.16.1-scala_2.12-java11
FROM ${TEMURIN_IMAGE} AS temurin-jre

FROM ${FLINK_IMAGE}

# Flink 1.16.1 was published with a Java 11 image.  Keep its official
# entrypoint and setup, but replace its bundled JRE with the selected Temurin
# LTS runtime so it matches the JDK used to compile the jobs in CI.
USER root
RUN rm -rf "${JAVA_HOME}"
COPY --from=temurin-jre /opt/java/openjdk /opt/java/openjdk
RUN java --version

# Both modules are placed below usrlib. The FlinkDeployment template selects
# the exact JAR through its jarURI.
COPY --chown=flink:flink usrlib/ /opt/flink/usrlib/
USER flink
