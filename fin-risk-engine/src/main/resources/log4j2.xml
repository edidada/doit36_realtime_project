<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Relative to JVM working directory; override with -Drealtime.log.dir=... -->
        <Property name="logDir">${sys:realtime.log.dir:-logs/runtime}</Property>
        <Property name="pattern">%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%t] %c - %replace{%msg}{[\r\n]+}{ }%n%throwable</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout charset="UTF-8" pattern="${pattern}"/>
        </Console>
        <RollingFile name="File" fileName="${logDir}/fin-risk-engine.log"
                     filePattern="${logDir}/archive/fin-risk-engine-%d{yyyy-MM-dd}-%i.log.gz"
                     createOnDemand="true" append="true" immediateFlush="true">
            <PatternLayout charset="UTF-8" pattern="${pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7">
                <Delete basePath="${logDir}/archive" maxDepth="1">
                    <IfFileName glob="fin-risk-engine-*.log.gz"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="com.test.bigdata" level="INFO"/>
        <Logger name="org.apache.hadoop" level="ERROR"/>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
