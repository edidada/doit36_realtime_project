        <!-- 日志配置说明（2026-10-11，与 rt_rule_mk 同步处理）：
             flink-doris-connector-1.14_2.12:1.1.0 这个 fat jar 内部自带一份 SLF4J 绑定
             （org/slf4j/impl/StaticLoggerBinder，即 log4j-slf4j-impl → Log4j2），
             藏在 jar 里用 <exclusion> 排不掉，再引 slf4j-log4j12 就必然报
             "Class path contains multiple SLF4J bindings"。
             做法：删掉 slf4j-log4j12，只保留 doris 那一份绑定；同时显式引入完整的
             log4j-api / log4j-core（必须声明在 doris 依赖之前）——doris 里 shade 的 log4j-core
             插件注册表被 log4j-web 覆盖坏了（Console appender / %d %msg 等转换器全丢），
             不覆盖就会出现"日志不输出 + StatusLogger Unrecognized conversion specifier"。
             配置见 src/main/resources/log4j2.xml；log4j:log4j(1.x) 保留给 hadoop 系老代码兜底。 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.17.2</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.2</version>
        </dependency>

        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.16</version>
        </dependency>


