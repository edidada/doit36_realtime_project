<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="logDir">${sys:main.log.dir:-logs/runtime}</Property>
    <Property name="mainName">${sys:main.class:-application}</Property>
    <Property name="pattern">[%level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c - %m%n%throwable</Property>
  </Properties>
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="${pattern}"/></Console>
    <RollingFile name="File" fileName="${logDir}/${mainName}.log" filePattern="${logDir}/${mainName}-%i.log.gz">
      <PatternLayout pattern="${pattern}"/>
      <Policies><SizeBasedTriggeringPolicy size="20 MB"/></Policies>
      <DefaultRolloverStrategy max="3"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.hadoop" level="ERROR"/>
    <Root level="INFO"><AppenderRef ref="Console"/><AppenderRef ref="File"/></Root>
  </Loggers>
</Configuration>
